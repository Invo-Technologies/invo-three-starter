# Nothing is required: with no secrets the game runs on INVO's public demo sandbox.
# On Replit use Tools -> Secrets instead of this file. Never commit real values.

# Going live: both from the INVO console. The SDK picks production from the key.
# INVO_GAME_SECRET=
# INVO_WEBHOOK_SECRET=

# Optional
# PUBLIC_URL=https://your-game.replit.app   set automatically on Replit
# DATABASE_URL=postgres://...                keeps the ledger in Postgres (recommended before going live)
# INVO_PROJECT_ID=                           normally leave unset; the SDK makes one per copy
