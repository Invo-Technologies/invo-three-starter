{
  "name": "invo-three-starter",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal Three.js + TypeScript 3D arena starter with INVO's game economy wired in: wallet, premium currency through INVO hosted checkout, an item shop whose purchases appear in the world, earned currency and loyalty events.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@invonetwork/three": "^1.0.0",
    "@invonetwork/web-sdk": "^3.30.1",
    "pg": "^8.23.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "pg-mem": "^3.0.14",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
