modules = ["nodejs-20"]
run = "npm install --no-audit --no-fund && npm run dev"
entrypoint = "src/main.ts"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install --no-audit --no-fund && npm run build"]
run = ["npm", "start"]

[[ports]]
localPort = 3000
externalPort = 80
